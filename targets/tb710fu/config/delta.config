# TB710FU / SM8650Q（联想小新 Pad Pro GT）相对原厂 GKI 6.1.128 的配置增量
#
# 来源：coloros-pad-fixes-main/kernel-compat/configs/droidspaces-r3.config
#       diff stock-6.1.128-ab13606743.config -> 剔除工具链自动生成项后的 19 行
#
# 只保留【人为设定】的项。CC_VERSION_TEXT / CLANG_VERSION / AS_VERSION /
# LLD_VERSION / PAHOLE_VERSION / UAPI_HEADER_TEST 这些是 olddefconfig 根据
# 实际编译器自动重算的，写死反而会与实际工具链不符，故不收录。
#
# 应用方式：cat base.config delta.config > .config && make olddefconfig

# ---- 厂商模块签名策略：原厂为 y，必须关掉，否则 289 个 Lenovo 模块 sig_ok=false 被拒 ----
# CONFIG_MODULE_SIG_PROTECT is not set

# ---- DroidSpaces / 容器支持（配合 0002-sysvipc-kabi-slots.patch 才安全）----
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y

# ---- 容器挂载与 tmpfs 扩展属性 ----
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
# CONFIG_DEVTMPFS_SAFE is not set
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
