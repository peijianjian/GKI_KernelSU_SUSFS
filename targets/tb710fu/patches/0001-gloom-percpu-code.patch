# TB710FU / GKI 6.1.128 @5c2cea985a84 内核补丁（2026-09-13）
#
# 前提：必须用【原厂内核】的 .config（TRIM_UNUSED_KSYMS=y + abi_symbollist.raw），
#       不能用 r1+ 的 /proc/config.gz（那份 TRIM 是关的，会导致 65% 符号 CRC 与
#       厂商模块对不上，module_layout 首先就不匹配，开机第一屏即重启）。
#       唯一该改的配置是 MODULE_SIG_PROTECT=n。
#
# 1) PERCPU_MODULE_RESERVE 8KB -> 32KB：让 oplus_resctrl 与 game_opt 共存。
# 2) gloom 的三个 vendor hook + mm/mmap.c 调用点。
# 3) pcppages_opt 的 android_vh_drain_all_pages_bypass + mm/page_alloc.c 调用点。
# 4) 导出 gloom 需要的四个符号（一加原版走高通 android_debug_symbol，缺头文件）。
# 5) libbpf.c 主机工具补丁（仅 resolve_btfids）。
# 另需把新增符号补进 abi_symbollist.raw，否则 TRIM 会裁掉它们。
#
--- a/include/linux/percpu.h
+++ b/include/linux/percpu.h
@@ -14,7 +14,7 @@
 
 /* enough to cover all DEFINE_PER_CPUs in modules */
 #ifdef CONFIG_MODULES
-#define PERCPU_MODULE_RESERVE		(8 << 10)
+#define PERCPU_MODULE_RESERVE		(32 << 10)
 #else
 #define PERCPU_MODULE_RESERVE		0
 #endif
